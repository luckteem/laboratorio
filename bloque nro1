        "q": ejercicio_q,
        "r": ejercicio_r,
    }

    while True:
        print("\n--- MENÚ DE EJERCICIOS ---")
        print("a-r: Elegir ejercicio")
        print("x: Salir")
        opcion = input("Ingrese una opción: ").lower()

        if opcion == "x":
