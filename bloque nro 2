def ejercicio_p():
    opciones = ["piedra", "papel", "tijera"]
    usuario_gana = 0
    compu_gana = 0
    for _ in range(3):
        usuario = input("Elija piedra, papel o tijera: ").lower()
        compu = random.choice(opciones)
        print("Computadora eligió:", compu)
        if usuario == compu:
            print("Empate")
        elif (usuario == "piedra" and compu == "tijera") or \
             (usuario == "papel" and compu == "piedra") or \
             (usuario == "tijera" and compu == "papel"):
            print("Ganaste")
            usuario_gana += 1
        else:
            print("Perdiste")
            compu_gana += 1
    if usuario_gana > compu_gana:
        print("Ganaste más rondas")
    elif compu_gana > usuario_gana:
        print("La computadora ganó más rondas")
    else:
        print("Empate en rondas")

def ejercicio_q():
    nums = [random.randint(1, 100) for _ in range(10)]
    print("Números:", nums)
    mayores = sum(1 for n in nums if n > 50)
    print("Cantidad mayores a 50:", mayores)

def ejercicio_r():
    datos = []
    for i in range(5):
        nombre = input("Ingrese nombre: ")
        nota = float(input("Ingrese nota: "))
        datos.append((nombre, nota))
    promedio = sum(n for _, n in datos) / len(datos)
    mejor = max(datos, key=lambda x: x[1])
    print("Promedio general:", promedio)
    print("Mejor nota:", mejor[0], "con", mejor[1])

