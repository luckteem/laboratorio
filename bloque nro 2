def ejercicio_l():
    for i in range(100, 201):
        if i % 7 == 0 and str(i).endswith("3"):
            print(i)

def ejercicio_m():
    total = 0
    productos = 0
    while total <= 1000:
        precio = float(input("Ingrese precio: "))
        total += precio
        productos += 1
    print("Se cargaron", productos, "productos")

