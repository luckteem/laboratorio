
import random

def ejercicio_a():
    numero_secreto = random.randint(1, 10)
    while True:
        intento = int(input("Adivine el número (1-10): "))
        if intento == numero_secreto:
            print("¡Correcto!")
            break
        elif intento > numero_secreto:
            print("El número es menor")
        else:
            print("El número es mayor")

def ejercicio_b():
    num = int(input("Ingrese un número: "))
    print("Divisores:", [i for i in range(1, num+1) if num % i == 0])

def ejercicio_c():
    fib = [0, 1]
    while len(fib) < 20:
        fib.append(fib[-1] + fib[-2])
    print("Serie Fibonacci:", fib)

def ejercicio_d():
    op = input("Ingrese operación (+, -, *, /): ")
    a = float(input("Ingrese primer número: "))
    b = float(input("Ingrese segundo número: "))
    if op == "+":
        print("Resultado:", a+b)
    elif op == "-":
        print("Resultado:", a-b)
    elif op == "*":
        print("Resultado:", a*b)
    elif op == "/":
        if b != 0:
            print("Resultado:", a/b)
        else:
            print("Error: división por cero")

def ejercicio_e():
    num = int(input("Ingrese un número: "))
    fact = 1
    for i in range(1, num+1):
        fact *= i
    print("Factorial:", fact)

def ejercicio_f():
    turnos = []
    while True:
        nombre = input("Ingrese nombre (fin para terminar): ")
        if nombre.lower() == "fin":
            break
        turnos.append(nombre)
    for i, n in enumerate(turnos, 1):
        print(f"Turno {i}: {n}")

def ejercicio_g():
    pares = [i for i in range(1, 101) if i % 2 == 0]
    print("Cantidad de pares entre 1 y 100:", len(pares))

def ejercicio_h():
    while True:
        c = float(input("Ingrese temperatura en °C (999 para salir): "))
        if c == 999:
            break
        f = (c * 9/5) + 32
        print(f"{c}°C = {f}°F")

def ejercicio_i():
    num = int(input("Ingrese un número: "))
    if num < 2:
        print("No es primo")
        return
    for i in range(2, int(num**0.5)+1):
        if num % i == 0:
            print("No es primo")
            return
    print("Es primo")

