using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("=== 3. BÚSQUEDA DE CIUDAD ===");

        // Apunte: Arreglo ya inicializado
        string[] ciudades = { "Madrid", "Buenos Aires", "Bogotá", "Lima", "Santiago" };

        Console.Write("Ciudad a buscar: ");
        string buscada = Console.ReadLine();

        int posicion = -1; // Apunte: -1 = "no encontrada" por defecto

        // Búsqueda secuencial con for
        for (int i = 0; i < ciudades.Length; i++)
        {
            // Apunte: IgnoreCase para que no importe mayúscula/minúscula
            if (ciudades[i].Equals(buscada, StringComparison.OrdinalIgnoreCase))
            {
                posicion = i;
                break; // Apunte: break corta el for apenas encuentra
            }
        }

        if (posicion!= -1)
            Console.WriteLine($"Encontrada en índice: {posicion}");
        else
            Console.WriteLine("Ciudad no encontrada");
    }
}

